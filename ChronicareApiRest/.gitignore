## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2022 cache/options directory
.vs/

# ASP.NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# EF Core Migrations build output
Migrations/*/bin/
Migrations/*/obj/

# Generated files
Generated\ Files/

# Windows image file caches
Thumbs.db
ehthumbs.db

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Desktop.ini

# Rider / JetBrains IDEs
.idea/
*.sln.iml

# VS Code
.vscode/
.history/

# NuGet
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets

# Paket dependency manager
.paket/
paket-files/

# Azure Functions local settings
local.settings.json

# Logs
*.log
*.tlog

# Publish outputs
publish/
*.pubxml
*.pubxml.user

# Runtime artifacts
*.pid
*.seed
*.pid.lock

# IIS Express
/.vs/
App_Data/
*.dbmdl
*.mdf
*.ldf

# JSON secrets
secret.json
secrets.json

# Environment-specific files
appsettings.Development.json
appsettings.Local.json
appsettings.*.json

# SSL dev certificates
*.pfx
*.p12

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# StyleCop
StyleCopReport.xml

# Coverlet / code coverage
coverage*.json
coverage*.xml
coverage*.info
coverage/
.coverage
*.lcov

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# node_modules for SPA templates (React/Angular)
node_modules/

# Angular/React build folders
dist/
wwwroot/dist/
wwwroot/node_modules/

# Cache
*.cache
*.vspscc
*.vssscc
*.db
*.sdf
*.sqlite

# Backup files
*.bak
*.backup
*.orig

# Temporary
*.tmp
*.temp
*.swp
*.swn
*.swo

# Exception reports
*.dmp
